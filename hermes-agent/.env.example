# Hermes companion stack configuration.
# Copy to /opt/hermes-stack/.env and chmod 600. NEVER commit the real file,
# and never paste these values into a chat with the agent (guide §2).

# --- Hermes harness workspace ---------------------------------------------------
# Hermes Agent (github.com/NousResearch/hermes-agent) workspace — ~/.hermes
# for the installing user (root install per the guide).
HERMES_HOME=/root/.hermes
# Where task drops land; the agent's inbox-sweep cron skill reads this.
HERMES_INBOX_DIR=/root/.hermes/inbox
# Root of the scraped RevOps knowledge base.
KNOWLEDGE_DIR=/root/.hermes/knowledge/revops

# --- Dispatch: how the companion hands tasks to the RUNNING agent ---------------
# Inbox file-drop is always on; the inbox-sweep cron skill guarantees pickup
# (hermes cron create "5m" "Run the inbox-sweep skill" --name inbox-sweep).
# Optional accelerator for instant pickup — Hermes' native inbound webhook
# platform (enable in ~/.hermes/.env: WEBHOOK_ENABLED=true, WEBHOOK_PORT=8644,
# WEBHOOK_SECRET=...; register a route with `hermes webhook subscribe`, then
# check `hermes webhook --help` for the exact route auth/payload contract):
#HERMES_HOOK_URL=http://127.0.0.1:8644/webhooks/hermes-stack
#HERMES_HOOK_TOKEN=
# Alternative accelerator — one-shot CLI (synchronous; fine for short pings,
# the inbox sweep covers long tasks):
#HERMES_CLI_TEMPLATE=hermes chat -q "A new task file was dropped at {task_file}. Read it and execute it following the inbox-sweep skill protocol."

# --- Bridge: HubSpot -> VPS ------------------------------------------------------
# Shared secret for the workflow custom-code action. Generate:
#   openssl rand -hex 32
# and store the SAME value as a secret in the HubSpot custom-code action.
HERMES_WEBHOOK_SECRET=
# Public URL of the bridge as HubSpot calls it (used for v3 signature checks).
BRIDGE_PUBLIC_BASE_URL=https://agent.example.com
# Only needed if you use HubSpot's native "Send a webhook" action instead of
# the custom-code action (X-HubSpot-Signature-v3 verification):
#HUBSPOT_CLIENT_SECRET=
#BRIDGE_MAX_BODY_BYTES=65536

# --- HubSpot: agent -> portal -----------------------------------------------------
# Dedicated "Hermes Agent" private app token (Settings > Integrations >
# Private apps). Scopes: crm.objects.{contacts,companies,deals}.read + .write
# (notes/tasks ride on these object scopes — see skills/revops/hubspot-crm/).
# Decision 2026-07-13: validate on sandbox 49610528 first, then swap both
# values for prod 9201667 at cutover.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=49610528

# --- Telegram ingestion (user session for SCRAPING — not the gateway bot) --------
# From https://my.telegram.org > API development tools.
# Use a dedicated, aged, non-critical Telegram account for this session.
# Leave empty to run the zero-auth t.me/s/ web-preview mode.
#TELEGRAM_API_ID=
#TELEGRAM_API_HASH=
# Telethon StringSession generated LOCALLY (never log in interactively on the
# VPS): python scraper/make_session.py
#TELEGRAM_SESSION=

# --- Paths (defaults are fine when installed at /opt/hermes-stack) -----------------
#SOURCES_FILE=/opt/hermes-stack/scraper/sources.yaml
#STATE_DIR=/opt/hermes-stack/scraper/state
